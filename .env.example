# Iron Arena — environment configuration. Copy to .env.local (client) / set in your host (server).

# ───────────── CLIENT (Vite — baked in at build time) ─────────────
# Multiplayer server WebSocket URL used by the browser.
#   • UNSET for local dev: falls back to ws://<page-host>:8080 (run `npm run server`).
#   • Production: your deployed server, over TLS:   VITE_SERVER_URL=wss://play.your-domain.com
# VITE_SERVER_URL=wss://play.your-domain.com

# ───────────── SERVER (Node — set in the host's environment) ─────────────
# Account database. Production = a hosted, always-on Postgres (Neon / Supabase / any):
#   IRON_DB=postgres
#   DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Local dev default (no config needed): a SQLite file in server/data/ (IRON_DB=sqlite).
# IRON_DB=postgres
# DATABASE_URL=

# Browsers allowed to connect (comma-separated origins). Set this in production.
# ALLOWED_ORIGINS=https://play.your-domain.com

# Behind a proxy/load balancer (Fly, Render, Railway, Cloudflare): trust X-Forwarded-For for rate limits.
# TRUST_PROXY=1

# Optional tuning
# PORT=8080
# SESSION_TTL_DAYS=30          # how long a login session lasts
# AUTH_RATE_PER_MIN=60         # auth-type messages per IP per minute
# PG_POOL_MAX=5
# PGSSLMODE=disable            # only for a local, non-TLS Postgres

# DEV ONLY: lets the TEST button unlock everything on the SERVER account.
#   Default: ON unless NODE_ENV=production.  Force with IRON_DEV_UNLOCK=1 / 0.
# IRON_DEV_UNLOCK=0
