# Iron Arena — environment configuration (copy to .env.local or set in your host).
#
# Multiplayer server WebSocket URL used by the client.
#   • Leave UNSET for local dev — the client falls back to ws://<page-host>:8080
#     (run the server with `npm run server`).
#   • Set for production to your deployed server, e.g.:
#       VITE_SERVER_URL=wss://play.your-domain.com
#     Use wss:// (secure) whenever the site is served over https.
# VITE_SERVER_URL=wss://play.your-domain.com
